# asc-testflight-feedback
#
# cp .env.example .env && chmod 600 .env
#
# The App Store Connect key is a THREE-part credential: issuer id, key id, and a
# .p8 private key file. All three are needed; two of three fails at 401.
#
# Generate the key at:
#   App Store Connect -> Users and Access -> Integrations -> App Store Connect API
#
# Use a NEW key for this service, not the one that uploads builds. This service
# only reads feedback and has no business being able to ship a release. Give it
# the narrowest role that can read beta feedback.
#
# The .p8 downloads exactly ONCE and cannot be re-downloaded. Store it outside
# this repo (the path below is gitignored) and note the key id somewhere durable.

ASC_ISSUER_ID=
ASC_KEY_ID=

# Absolute path ON THE HOST to the .p8 file. Mounted read-only into the container.
# Keep it outside the repo tree: <repo>/secrets/asc_key.p8 (gitignored).
ASC_KEY_HOST_PATH=./secrets/asc_key.p8

# Postgres. docker-compose.yml brings its own; point PGHOST elsewhere if you
# already run one. PGPASSWORD has no default — compose refuses to start without
# it rather than standing up a database with a blank password.
PGUSER=testflight
PGPASSWORD=
POSTGRES_DB=testflight

# The uid:gid that owns the .p8 on the host. The container runs as this so it
# can read a key that is mode 600 and not world-readable.
RUN_AS_UID=1000
RUN_AS_GID=1000

# How often to pull, in seconds. Beta feedback is not real-time-critical and
# Apple rate limits, so 15 minutes is the default rather than 1.
POLL_SECONDS=900
